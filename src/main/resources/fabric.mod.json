{
	"schemaVersion": 1,
	"id": "antique_atlas_multiplayer",
	"version": "${version}",
	"name": "Antique Atlas Multiplayer",
	"description": "Antique Atlas addon: shows every other player on the server on your atlas.",
	"authors": ["darshan"],
	"license": "LGPL-3.0-or-later",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.antiqueatlasmultiplayer.AntiqueAtlasMultiplayer"
		],
		"client": [
			"io.github.antiqueatlasmultiplayer.client.AntiqueAtlasMultiplayerClient"
		]
	},
	"mixins": [
		"antique_atlas_multiplayer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"antique_atlas": ">=3.1.0"
	}
}
